# Generate every secret below with: openssl rand -hex 32
# MYSQL_ROOT_PASSWORD is only read by docker-compose (the backend cannot
# check it): never leave it empty or set it to a well-known value.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=nestwiki

MINIO_ACCESS_KEY=nestwiki
# Must be the same value as MINIO_SECRET_KEY in backend/.env.
MINIO_SECRET_KEY=

# Host address the backend (3000) and frontend (8080) ports are published
# on. 127.0.0.1 keeps them reachable only from the host (reverse proxy or
# tunnel running there); 0.0.0.0 exposes them on every interface.
BIND_ADDRESS=127.0.0.1

# docker-compose.yml only: host address the MySQL (3306) and object
# storage (9000, console 9001) ports are published on. Keep 127.0.0.1
# unless another machine must reach them directly (e.g. a development
# backend running elsewhere): 0.0.0.0 exposes them on every interface.
BACKING_BIND_ADDRESS=127.0.0.1
# Object storage web console on port 9001, off by default.
RUSTFS_CONSOLE_ENABLE=false

# Sites allowed to show the wiki in an iframe (frame-ancestors of the
# frontend's Content-Security-Policy), separated by spaces. 'self' only
# by default. Keep the outer double quotes so the single ones stay:
# CSP_FRAME_ANCESTORS="'self' https://example.org https://*.example.org"
CSP_FRAME_ANCESTORS="'self'"

# docker-compose.external.yml only: existing Docker networks where the
# backend reaches the database and the object storage. Both default to
# mariadb-network; point them at dedicated --internal networks to isolate
# the backend from the other containers (see docs/deployment.md).
DATABASE_NETWORK=mariadb-network
STORAGE_NETWORK=mariadb-network

# docker-compose.external.yml only: memory limit of the backend
# container. NESTWIKI_TAG (image tag, latest by default) is set by the
# deploy workflow, no need to define it here.
BACKEND_MEM_LIMIT=1g

# Only read by `docker compose build` (frontend service `build.args`) —
# Vite bakes these into the static bundle at build time, so they must
# be set here (not just in frontend/.env) for a production deploy.
VITE_API_URL=https://your-domain.example/api
VITE_TURNSTILE_SITE_KEY=
