PORT=3000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
# The backend refuses to start while a secret below is missing, too
# short or a well-known default (changeme, minioadmin, root…).
# Generate each one with: openssl rand -hex 32
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=nestwiki

# At least 32 characters each, and different from one another.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# First admin account, created automatically when the database has no
# admin yet (first start). Never modified afterwards: change the password
# from the app once logged in. The password needs 8+ characters with an
# uppercase letter, a digit and a symbol.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=nestwiki
MINIO_SECRET_KEY=
MINIO_BUCKET=nestwiki
MINIO_USE_SSL=false
# Only needed in prod, when MINIO_ENDPOINT is a Docker-internal
# hostname unreachable from a browser (e.g. the `minio` service name).
# Publicly routable host used only to sign presigned media URLs — the
# backend still talks to Minio internally via MINIO_ENDPOINT. Leave
# unset in local dev, where MINIO_ENDPOINT is already reachable.
# MINIO_PUBLIC_ENDPOINT=cdn.example.com
# MINIO_PUBLIC_PORT=443
# MINIO_PUBLIC_USE_SSL=true

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The API checks GitHub's public API for a newer NestWiki release (at most
# every 6 hours) to notify admins. Set to false to disable this request.
UPDATE_CHECK=true